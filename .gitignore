# ============================================================
# 根 .gitignore —— 仓库级通用忽略（依赖/产物/日志/OS/编辑器）
# 项目专属规则（TS 编译产物、打包资源白名单）见 dsh-desktop/.gitignore
# ============================================================

# ---- 依赖 ----
node_modules/
# 微信桥接插件（本地目录，未入库）

# 本地参考文档（不随 PR 提交）
docs/语音识别设计参考.md

# Build artifacts
dsh-desktop/dist/

# Runtime vendor (node.exe + npm, generated by fetch-runtime)
dsh-desktop/vendor/

# Runtime cache & dev data
.dev-data/
.update-test/

# openclaw-dsh-bridge (微信桥接插件) build artifacts

openclaw-dsh-bridge/node_modules/
openclaw-dsh-bridge/dist/

# ---- 构建产物 ----
# tsc 编译输出（原地 .js 产物由 dsh-desktop/.gitignore 忽略）
dsh-desktop/dist/
# tsc 增量编译缓存
*.tsbuildinfo

# ---- 运行时 vendor（fetch-node/fetch-npm 生成的 node.exe + npm CLI）----
dsh-desktop/vendor/

# ---- 运行时数据 / 测试沙箱 ----
# 开发调试与更新模拟的本地数据（含真实会话，勿入库）
.dev-data/
.update-test/
# 测试运行数据（dsh home / 打包探针）
dsh-desktop/.dsh-test-home/
dsh-desktop/.dsh-packaged-test/
dsh-desktop/test/.dsh-home-repro/
dsh-desktop/.dsh-test-runtime/
# 源码树外的独立测试运行时（权限允许时 smoke 脚本使用）
.test-runtime/
# 桌面壳运行数据目录
dsh-desktop/data/
# 旧壳时代的根目录 updates/ 待装目录规则已移除：updates/ 现为热更新发布
# 目录（hotupdate.json/release.json/packages，git push 即发布，见主设计 §3）；
# 运行期待装目录在 userData/updates（userData 不在仓库内，无需忽略）。
# 一次性调试目录
# 一次性调试目录
/tmp-p2boot/

# ---- 日志与临时文件 ----
*.log
*.tmp

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 编辑器 / IDE ----
.vscode/
.idea/

# ---- Python 构建产物（picturereader setup 脚本 / dsh-dafeiyu helper 等）----
__pycache__/
*.pyc

# ---- bench 基线报告（机器相关数字，本地保留供 --compare 回归对比）----
dsh-desktop/bench-*.json

# ---- Reasonix 工具元数据（勿提交）----
.reasonix/

# 热更新冒烟沙箱（hotupdate-smoke.js 运行时重建）
tmp-hotupdate-smoke/
