node_modules/
dist/
vendor/
*.log
data/
.playwright-mcp/
.DS_Store
# TypeScript 编译产物：只提交 .ts 源码，.js 由 `npm run build` 原地生成
# （scripts/koffi-preflight.cjs 为运行时探针资产，保持入库，见下方否定规则）
/*.js
/lib/**/*.js
/host-electron/**/*.js
/shared/**/*.js
/preload/*.js
/preload-lib/**/*.js
/scripts/*.js
!scripts/koffi-preflight.cjs
# Rust 原生模块：cargo target 不入库；index.node 为平台相关构建产物，
# 不入库（Windows 编译的 .node 在 Linux/macOS 加载即 ERR_DLOPEN_FAILED，
# CI 各平台由 build:native 在测试前自行生成）
/native/supervisor/target/
/native/snapshot/target/
/native/supervisor/index.node
/native/snapshot/index.node
# 临时调试 / 备份产物不入库
debug-session-dump.cjs
e2e-base.txt
package.json.bak-*
scripts/tmp-dbg*.cjs
scripts/tmp-instrument.cjs
# build/ 只保留图标与 NSIS 安装脚本，其余构建产物不入库
build/*
!build/icon.ico
!build/icon.png
!build/installer.nsh
# 内置社区插件的 vendor / 自包含运行时依赖 / 离线数据必须随仓库分发，
# 否则克隆后构建出的安装包会复现“插件命名空间不可用”（vendor 缺失）
# 与“tdai-memory 无法启动”（sqlite-vec / jieba / BM25 语料缺失）
!assets/plugins/*/vendor/
!assets/plugins/*/data/
