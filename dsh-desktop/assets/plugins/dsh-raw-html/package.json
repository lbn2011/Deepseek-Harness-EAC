{
  "name": "dsh-raw-html",
  "version": "0.6.2",
  "description": "EAC 托管的 VCP 视觉通感插件：通过官方 conversation slot 隔离渲染 HTML，并提供字体、美学和设计规范能力",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "vcp",
    "visual-synesthesia",
    "html",
    "rendering"
  ],
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "assets",
    "tools/*.cjs",
    "tools/*.py",
    "docs",
    "cordis.patch.yml",
    "DESIGN.md",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "VCP-INTERACTIONS.md",
    "FRAMING.md",
    "EDITORIAL.md",
    "BREATH.md",
    "styles",
    "examples",
    "fonts-index.txt"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "react",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.3.1"
  },
  "license": "MIT",
  "optionalDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
